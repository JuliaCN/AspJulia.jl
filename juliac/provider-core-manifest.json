{
  "schemaId": "agent.semantic-protocols.provider-core-manifest",
  "schemaVersion": "1",
  "languageId": "julia",
  "providerId": "asp-julia",
  "displayName": "Julia",
  "extensions": [".jl"],
  "projectMarkers": ["Project.toml"],
  "syntaxSurface": {
    "lineComment": "#",
    "blockComment": ["#=", "=#"],
    "delimiterPairs": [["(", ")"], ["[", "]"], ["{", "}"]],
    "stringDelimiters": ["\""]
  },
  "transport": {
    "transport": "http-json",
    "command": ["serve"],
    "healthPath": "/health",
    "requestPath": "/v1/provider-runtime",
    "shutdownPath": "/shutdown"
  },
  "capabilities": {
    "astInspect": true,
    "astVerify": true,
    "openEdb": true,
    "projectResolution": true
  }
}
